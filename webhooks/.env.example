# Copiar a webhooks/.env. Ese archivo no se sube: .env está en el .gitignore.
# Si GITHUB_SECRET queda vacío o no está, la app usa el secreto de práctica
# de app/github_webhook.py. Sirve para el curl local.
# Para un webhook real, el mismo texto va en GitHub, en el campo Secret.
GITHUB_SECRET=

# URL de un webhook de Discord. En el canal: Ajustes, Integraciones,
# Webhooks, Nuevo webhook, Copiar URL del webhook.
# Vacío: el issue se guarda y no se avisa a Discord.
DISCORD_WEBHOOK_URL=
